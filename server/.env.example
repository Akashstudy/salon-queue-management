# Server Port (Render sets this dynamically in production, default: 4000 locally)
PORT=4000

# Allowed frontend origin(s) for CORS.
# In production, set this to your Vercel deployment URL (e.g. https://your-project.vercel.app).
# For multiple origins, separate with commas: https://your-project.vercel.app,http://localhost:5173
# Use * to allow all origins during initial testing.
CORS_ORIGIN=*

# Staff passcode for Reception, Barber, and Admin screens
STAFF_PIN=2468

# Set to 1 to enable online queue joining 24/7 (bypassing the 8:30 PM IST cutoff)
IGNORE_HOURS=1

# Elapsed minutes after a customer is called before they can be marked as a no-show
NOSHOW_MINUTES=10
